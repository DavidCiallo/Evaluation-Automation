SERVER_PORT=2900
SECRET=MySecretPassphrase1234567890abcABCEFGefg
NONCE_LENGTH=8
ADMIN_NAME=Administrator
ADMIN_EMAIL=mail@example.com
ADMIN_PASSWORD=demo123@


CORPID=ww12345678d0c280af
AGENTID=1000001
WX_SECRET=qciM-AbcabcAbcaBcabCabc

SDK_HOST=http://127.0.0.1:8899
POLL_INTERVAL_MS=5000
# 会话摄入开关：off（默认，不轮询）| on（显式开启）
SYNC_POLLER=off
# 消息源：sdk（企微 SDK 轮询，默认）| qixioma（企小码 Web2API；上游 sender/chatName 修复后可用）
SYNC_SOURCE=sdk
QIXIOMA_BASE_URL=https://chat.noworrytourism.cn

# 存储：sqlite（默认，data/app.db）| jsonl（旧文件存储回退）
STORE_DRIVER=sqlite

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# 外围系统接入
# ------------------------------------------------------------
# 下面这几组变量的作用只是「首次部署的默认值 / 兜底」。
# 建好库之后，入口地址、账号、口令都建议改到界面里维护：
#   系统配置 → 外围系统接入（写入 data/app.db，不入仓库）
# 优先级：界面设置 > 环境变量 > 内置默认值；界面里「恢复默认」即清掉
# 库内该项设置、退回读这里的环境变量。
# ============================================================

# ---- 简表表单系统（survey.noworrytourism.cn）----
TYPEFORM_BASE_URL=https://survey.noworrytourism.cn
TYPEFORM_EMAIL=
TYPEFORM_PASSWORD=

# ---- 麦客表单捕获（mike.noworrytourism.cn）----
MIKE_BASE_URL=https://mike.noworrytourism.cn
MIKE_PASSWORD=
# 麦客提交摄入间隔（毫秒）；界面可改。MIKE_INGEST=off 表示默认停用该项
MIKE_INGEST_INTERVAL_MS=600000
MIKE_INGEST=on

# ---- ctrip 行程单/机票任务（ctrip.noworrytourism.cn）----
CTRIP_BASE_URL=https://ctrip.noworrytourism.cn
CTRIP_PASSWORD=

# ---- NW邮箱（email.noworrytourism.cn）----
EMAIL_BASE_URL=https://email.noworrytourism.cn
EMAIL_EMAIL=
EMAIL_PASSWORD=
# 收件-客户关联扫描间隔（毫秒）；界面可改。EMAIL_LINK=off 表示默认停用该项
EMAIL_LINK_INTERVAL_MS=900000
EMAIL_LINK=on

# ---- 机器人回调（外部分配账号后回写任务） ----
# 必填：/api/robot-task/callback 是公开路径，鉴权只靠这个口令 + 任务 id。
ROBOT_CALLBACK_TOKEN=

# ---- 客户信息确认单（contract.noworrytourism.cn） ----
# 以上三项都建议改到界面里维护：系统配置 → 外围系统接入。
# 优先级：界面设置 > 环境变量 > 内置默认值
CONTRACT_BASE_URL=https://contract.noworrytourism.cn
# 建单用的共享口令，放在请求头 token 里
CONTRACT_API_KEY=
# 内部签署人成员 id（逗号分隔）；留空用内置默认 xiaolv,xiaoning
CONTRACT_INTERNAL_SIGNERS=

